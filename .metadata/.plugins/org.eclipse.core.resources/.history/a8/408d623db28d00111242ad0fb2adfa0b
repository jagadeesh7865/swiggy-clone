package com.swiggy.swiggy_backend.repository;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertTrue;

import java.util.List;

import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.orm.jpa.DataJpaTest;
import org.springframework.boot.test.autoconfigure.orm.jpa.TestEntityManager;

import com.swiggy.swiggy_backend.entity.MenuItem;
import com.swiggy.swiggy_backend.entity.Restaurant;

@DataJpaTest()
public class MenuRepositoryTest {
	
	@Autowired
	private MenuRepository menuRepository;
	
	@Autowired
	private TestEntityManager entityManager;
	
	
	@Test
	void shouldFindMenuByRestaurantId() {

	    Restaurant restaurant = new Restaurant();
	    restaurant.setName("Dominos");
	    restaurant = entityManager.persistFlushFind(restaurant);

	    MenuItem item = new MenuItem();
	    item.setName("Pizza");
	    item.setRestaurant(restaurant);

	    entityManager.persistAndFlush(item);

	    List<MenuItem> result =
	            menuRepository.findByRestaurantId(restaurant.getId());

	    assertEquals(1, result.size());
	    assertEquals("Pizza", result.get(0).getName());
	}
	
	@Test
	void shouldReturnEmptyWhenRestaurantHasNoMenu() {

	    Restaurant restaurant = new Restaurant();
	    restaurant.setName("KFC");
	    restaurant = entityManager.persistFlushFind(restaurant);

	    List<MenuItem> result =
	            menuRepository.findByRestaurantId(restaurant.getId());

	    assertTrue(result.isEmpty());
	}
	
	@Test
	void shouldSearchMenuByName() {

	    Restaurant restaurant = new Restaurant();
	    restaurant.setName("Pizza Hut");
	    restaurant = entityManager.persistFlushFind(restaurant);

	    MenuItem pizza = new MenuItem();
	    pizza.setName("Veg Pizza");
	    pizza.setRestaurant(restaurant);

	    entityManager.persistAndFlush(pizza);

	    List<MenuItem> result =
	            menuRepository.findByNameContainingIgnoreCase("pizza");

	    assertEquals(1, result.size());
	}
	
	@Test
	void shouldReturnEmptyWhenKeywordNotFound() {

	    List<MenuItem> result =
	            menuRepository.findByNameContainingIgnoreCase("Burger");

	    assertTrue(result.isEmpty());
	}

}
